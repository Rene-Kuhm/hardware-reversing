<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rene.aio-display</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Python 3.14 desde python.org — no usar /usr/bin/python3 (es Python 3.9 de Xcode, no tiene hid) -->
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <!-- ADJUST THIS PATH: plists cannot expand variables, so point it at your
             clone, e.g. /Users/<you>/hardware-reversing/hydrotemp-aio/macos/monitor_macos.py
             For a variable-free setup, use the .pkg installer instead (build/build.sh),
             which installs a self-contained binary under /usr/local/lib/aio-display. -->
        <string>/Users/rene/hardware-reversing/hydrotemp-aio/macos/monitor_macos.py</string>
        <!-- To log sensors on every cycle, add one more <string> entry below
             containing the verbose flag (two dashes followed by "verbose").
             It cannot be shown commented out here: XML comments may not
             contain a double dash, which silently invalidates the whole plist. -->
    </array>

    <!-- Reiniciar automáticamente si el proceso muere -->
    <key>KeepAlive</key>
    <true/>

    <!-- Arrancar cuando el usuario inicia sesión -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Esperar 5 s al arrancar (da tiempo a que el USB se inicialice) -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/tmp/aio-display.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/aio-display.err</string>

    <!-- Variables de entorno (añadir PATH del virtualenv si usas uno) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>DYLD_LIBRARY_PATH</key>
        <string>/usr/local/lib</string>
    </dict>
</dict>
</plist>
