# ---------------------------------------------------------------
# Fusion de los .gitignore de los 5 repos originales.
# OJO: no usar "build/" a secas. hydrotemp-aio/macos/build/ contiene
# scripts versionados (build.sh, specs, plists, postinstall/preinstall).
# Por eso los artefactos de macOS se ignoran por ruta concreta.
# ---------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.venv/
.venv*/
venv/
monitor-env/

# Entorno local
.env
.env.*
!.env.example
config.json
config.toml

# Logs
*.log
*.err

# Salida de compilacion, a cualquier profundidad (como los originales)
dist/
build/

# ...pero hydrotemp-aio/macos/build/ contiene scripts versionados: se exceptua
!hydrotemp-aio/macos/build/
!hydrotemp-aio/macos/build/**

# ...y dentro de esa excepcion, los artefactos reales si se ignoran
hydrotemp-aio/macos/build/dist/
hydrotemp-aio/macos/build/work/
hydrotemp-aio/macos/build/pkg-root/
hydrotemp-aio/macos/build/dmg-staging/
hydrotemp-aio/macos/build/*.pkg
hydrotemp-aio/macos/build/*.dmg

# Nix
result
result-*

# Editores
.idea/
.vscode/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
